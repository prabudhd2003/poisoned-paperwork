# Local datasets and caches. Keep the empty directory in Git.
data/*
!data/.gitkeep
.cache/

# Experiment artifacts and model files
outputs/
checkpoints/
logs/
*.ckpt
*.pt
*.pth
*.safetensors

# Notebook-generated files
.ipynb_checkpoints/

# Secrets and local environment files
.env
.env.*
!.env.example

# Python and macOS
__pycache__/
*.py[cod]
.DS_Store

# Colab input staging (rebuilt by colab/receipts/fetch_full_inputs.sh)
colab/receipts/staging/
colab/receipts/inputs/source.tar
colab/receipts/*.zip
