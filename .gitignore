# Local datasets and caches. Keep the empty directory in Git.
data/*
!data/.gitkeep
.cache/

# Experiment artifacts and model files
outputs/
results/
checkpoints/
logs/
*.ckpt
*.pt
*.pth
*.safetensors

# Notebook-generated files
.ipynb_checkpoints/

# Prospectively collected receipts may contain private information. Keep the
# local folder available to the annotation notebook, but never commit images.
collected receipts/*

# Secrets and local environment files
.env
.env.*
!.env.example

# Python and macOS
__pycache__/
*.py[cod]
.DS_Store
